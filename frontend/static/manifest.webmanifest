      "description": "Perimeter security, visitor check-in, and pass verification"
    },
    {
      "name": "Visitor Passes",
      "short_name": "Passes",
      "url": "/app/resident-hub",
      "description": "Issue and manage digital visitor passes"
    },
    {
      "name": "Announcements",
      "short_name": "Notice Board",
      "url": "/app/announcements",
      "description": "Review society announcements and notices"
    }
  ]
