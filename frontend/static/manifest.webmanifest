{
  "id": "/",
  "name": "Banesons Society",
  "short_name": "Society",
  "description": "Cooperative Housing Society cloud operating system for residential governance, gatekeeping, and community operations.",
  "start_url": "/app/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f3f3f1",
