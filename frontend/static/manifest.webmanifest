      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Operations Hub",
      "short_name": "Dashboard",
      "url": "/app/dashboard",
      "description": "Society operational scorecards, notices, and quick actions"
    },
    {
      "name": "Gate Console",
      "short_name": "Gate",
